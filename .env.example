# Copy to .env and edit.  python-dotenv loads it automatically when the app starts.
# EVERYTHING here is optional — with no .env at all, PharmaIQ runs fully offline.

# ── Flask ──
SECRET_KEY=change-me-to-a-long-random-string

# ── LLM provider: offline (default) | anthropic | openai ──
PHARMAIQ_LLM_PROVIDER=offline

# Anthropic (Claude)
# PHARMAIQ_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# PHARMAIQ_MODEL=claude-sonnet-5-5

# OpenAI or any OpenAI-compatible server (Ollama, LM Studio, vLLM, Groq …)
# PHARMAIQ_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PHARMAIQ_MODEL=gpt-4o-mini
# PHARMAIQ_BASE_URL=https://api.openai.com/v1
#   Local Ollama example:  PHARMAIQ_BASE_URL=http://localhost:11434/v1   PHARMAIQ_MODEL=llama3.1

# How many result rows an LLM may see when writing an explanation (0 = aggregates only, nothing row-level leaves your server)
PHARMAIQ_LLM_MAX_ROWS=15
PHARMAIQ_LLM_TIMEOUT=30

# ── Retrieval ──
# tfidf (default, no download)  |  sentence-transformers (needs requirements-optional.txt)
PHARMAIQ_EMBEDDINGS=tfidf
# PHARMAIQ_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Limits ──
PHARMAIQ_MAX_ROWS=200
PHARMAIQ_SQL_TIMEOUT=3
PHARMAIQ_UPLOAD_MAX_MB=5

# ── Business rules (same defaults as app.py) ──
PHARMAIQ_LOW_STOCK=10
PHARMAIQ_EXPIRY_DAYS=30
